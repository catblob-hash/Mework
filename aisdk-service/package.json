{
  "name": "mework-aisdk-service",
  "private": true,
  "version": "0.1.0",
  "description": "Mework 的 AI SDK 侧车：一次 model step 的执行器。宿主是 Rust，协议是 stdio NDJSON。",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:sea": "node build.mjs --sea",
    "selfcheck": "node build.mjs && node selfcheck.mjs",
    "selfcheck:sea": "node build.mjs --sea && node selfcheck.mjs --sea",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.66",
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/azure": "^4.0.52",
    "@ai-sdk/google": "^4.0.54",
    "@ai-sdk/google-vertex": "^5.0.66",
    "@ai-sdk/openai": "^4.0.50",
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@ai-sdk/xai": "^4.0.47",
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "ai": "^7.0.83",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.0"
  }
}
