{
  "name": "mework",
  "private": true,
  "version": "1.0.1",
  "description": "Mework — Mew. Work.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/catblob-hash/Mework.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:browser": "node scripts/browser-dev.mjs",
    "reset:data": "node scripts/reset-app-data.mjs",
    "dev:memory-e2e-mock": "node scripts/memory-e2e.mjs",
    "dev:memory-e2e": "node scripts/memory-e2e.mjs --browser-dev",
    "test:memory-e2e": "node scripts/memory-e2e.mjs --self-check",
    "test:image-input-e2e": "node scripts/image-input-e2e.mjs",
    "test:web-search-e2e": "node scripts/web-search-e2e.mjs",
    "test:deepseek-e2e": "node scripts/deepseek-live-e2e.mjs",
    "test:release": "npm test && npm run test:web-search-e2e",
    "prob:fetch": "node scripts/prob-fetch.mjs",
    "test:prob-fetch": "node scripts/prob-fetch.mjs --self-check",
    "verify:formal": "node scripts/formal-verify.mjs",
    "build": "tsc && vite --config vite.config.ts build",
    "build:sidecar": "node scripts/build-aisdk-sidecar.mjs",
    "preview": "vite --config vite.config.ts preview",
    "test": "node scripts/shared-test.mjs",
    "test:rust": "node scripts/cargo-test.mjs",
    "test:direct": "npm run lint && npm run test:theme-colors && npm run test:component-i18n && npm run test:command-acl && npm run test:catalog-parity && npm run test:e2e-fixture-surface && npm run test:frontend-csp && npm run test:native-build-tools && npm run test:dev-child-environment && npm run test:dev-server-port && npm run test:browser-dev-lifecycle && npm run test:browser-dev-concurrency-fixture && npm run test:cargo-test-lifecycle && npm run test:debug-client-entrypoints && npm run test:workspace-coordinator && npm run test:memory-e2e-fixture && npm run test:reset-app-data-plan && npm run test:release-assets-plan && npm run test:third-party-licenses && vitest run",
    "test:theme-colors": "node scripts/check-theme-colors.mjs",
    "test:component-i18n": "node scripts/check-component-i18n.mjs",
    "test:command-acl": "node scripts/check-command-acl.mjs",
    "test:catalog-parity": "node scripts/check-catalog-parity.mjs",
    "test:e2e-fixture-surface": "node --test scripts/tests/e2e-fixture-surface.test.mjs",
    "test:frontend-csp": "node scripts/check-frontend-csp.mjs && node --test scripts/tests/frontend-csp-source.test.mjs scripts/tests/frontend-csp.test.mjs scripts/tests/frontend-csp-browser.test.mjs",
    "test:frontend-csp-browser": "node --test scripts/tests/frontend-csp-browser.test.mjs",
    "test:native-build-tools": "node --test scripts/tests/windows-native-build-tools.test.mjs",
    "test:dev-child-environment": "node --test scripts/tests/dev-child-environment.test.mjs",
    "test:dev-server-port": "node --test scripts/tests/dev-server-port.test.mjs",
    "test:browser-dev-lifecycle": "node --test scripts/tests/browser-dev-lifecycle.test.mjs",
    "test:browser-dev-concurrency-fixture": "node --test scripts/tests/browser-dev-concurrency-fixture.test.mjs",
    "test:cargo-test-lifecycle": "node --test scripts/tests/cargo-test-lifecycle.test.mjs",
    "test:debug-client-entrypoints": "node --test scripts/tests/debug-client-entrypoints.test.mjs",
    "test:workspace-coordinator": "node --test scripts/tests/workspace-coordinator.test.mjs",
    "test:memory-e2e-fixture": "node --test scripts/tests/memory-e2e-workspace-fixture.test.mjs",
    "test:reset-app-data-plan": "node --test scripts/tests/reset-app-data-plan.test.mjs",
    "test:release-assets-plan": "node --test scripts/tests/release-assets-plan.test.mjs",
    "test:third-party-licenses": "node --test scripts/tests/third-party-licenses.test.mjs",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri-with-build-tools.mjs",
    "tauri:dev": "node scripts/tauri-with-build-tools.mjs dev",
    "tauri:build": "node scripts/tauri-with-build-tools.mjs build",
    "package:portable": "node scripts/package-portable.mjs",
    "licenses:third-party": "node scripts/third-party-licenses.mjs",
    "release:assets": "node scripts/release-assets.mjs",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "format": "biome format --write src",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/build-site.mjs && node scripts/serve-site.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "marked": "^18.0.11",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
